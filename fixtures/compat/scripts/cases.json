{
  "run_script_snapshot_fields": [
    "id",
    "name",
    "description",
    "parameters",
    "source",
    "source_hash"
  ],
  "cases": [
    {
      "id": "snapshot-pin-ignores-live-edit",
      "type": "RunScriptSnapshot",
      "given": {
        "run_scripts": [
          {
            "id": "script_1",
            "name": "send_usdc",
            "description": "Sign and send USDC",
            "parameters": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string"
                }
              },
              "required": [
                "amount"
              ]
            },
            "source": "print('snap')\n",
            "source_hash": "<sha256 of snap source>"
          }
        ],
        "live_edit": {
          "name": "send_usdc",
          "source": "print('live')\n"
        }
      },
      "expect": {
        "execute_name": "send_usdc",
        "source": "print('snap')\n",
        "first_class_tool": true,
        "note": "Live catalog edit does not change source or schema on an existing run."
      }
    },
    {
      "id": "deleted-live-row-still-executable",
      "type": "RunScriptSnapshot",
      "given": {
        "run_scripts": [
          {
            "id": "script_1",
            "name": "send_usdc",
            "description": "Sign and send USDC",
            "parameters": null,
            "source": "print('snap')\n",
            "source_hash": "<sha256>"
          }
        ],
        "live_deleted": [
          "send_usdc"
        ]
      },
      "expect": {
        "script_run": {
          "name": "send_usdc",
          "source": "print('snap')\n"
        },
        "first_class_tool": false
      }
    },
    {
      "id": "live-extra-same-generation",
      "type": "live-extra",
      "given": {
        "run_scripts": [],
        "script_create_during_run": {
          "name": "scratch",
          "description": "ad hoc",
          "parameters": null,
          "source": "print('extra')\n"
        }
      },
      "expect": {
        "script_run": {
          "name": "scratch",
          "source": "print('extra')\n"
        },
        "first_class_tool_this_run": false,
        "write_through_running_sandbox": true
      }
    },
    {
      "id": "parameterised-next-run-only",
      "type": "dynamic-tool",
      "given": {
        "script_create": {
          "name": "priced",
          "description": "price a bag",
          "parameters": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              }
            },
            "required": [
              "symbol"
            ]
          },
          "source": "import json,sys; print(json.load(sys.stdin)['symbol'])\n"
        }
      },
      "expect": {
        "this_run_first_class": false,
        "next_run_first_class": true,
        "collision_with_native": false
      }
    },
    {
      "id": "materialise-temp-then-move",
      "type": "materialisation",
      "steps": [
        "write each snapshotted source to a sibling temp file via sandbox.files",
        "atomic move_files onto /home/agent/scripts/<name>.py",
        "write live-extra names absent from the snapshot the same way",
        "remove managed files whose names are in neither set",
        "retry on the next ensure after a files API failure"
      ],
      "expect": {
        "workspace_root_unused_for_managed_scripts": true,
        "direct_write_not_atomic": true
      }
    },
    {
      "id": "json-stdin-launcher",
      "type": "launcher",
      "given": {
        "arguments": {
          "quoted": "say \"hello\"",
          "newline": "line1\nline2",
          "unicode": "caf\u00e9",
          "large": ""
        }
      },
      "expect": {
        "transport": "RunCommandOpts.envs JSON then stdin",
        "stdout_is_tool_result": true,
        "shares_output_pipeline": true
      }
    },
    {
      "id": "schema-collision-rejection",
      "type": "validation",
      "cases": [
        {
          "name": "note_find",
          "error": "collides with a native or connection tool name"
        },
        {
          "parameters": {
            "type": "string"
          },
          "error": "parameters must be a JSON Schema object"
        }
      ]
    },
    {
      "id": "reconcile-after-sandbox-recreate",
      "type": "materialisation",
      "expect": {
        "restores_snapshotted": true,
        "restores_live_extra": true,
        "does_not_restore_unmanaged": true
      }
    }
  ]
}
