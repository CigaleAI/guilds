# The core stack's settings. ./setup.sh copies this file to .env and fills in the first four.

# --- Required; ./setup.sh writes them ---------------------------------------------------------

# Absolute path on the Docker host where the stack keeps its state.
STATE_ROOT=
# Encrypts stored credentials: 32 random bytes as hex. A lost key loses them.
SECRETS_MASTER_KEY=
POSTGRES_PASSWORD=
OPENSANDBOX_API_KEY=

# --- Integrations -----------------------------------------------------------------------------
# Platform keys (the GitHub App, the Google OAuth client, web search, group routing) are entered
# under Admin, Platform keys once the stack is up, and stored encrypted under SECRETS_MASTER_KEY.
# The integrations below are read from this file at start; each is optional. Admin, Platform keys
# shows the state of every integration.

# Error reporting: Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0

# --- Reaching the box ---------------------------------------------------------------------------

# The port the operator app is published on, on loopback.
ORCHESTRATOR_PORT=8080
# The stack does not authenticate: whoever reaches the port is the operator (compat-cookie).
# Behind your own authenticating proxy, trusted-header takes the user from the email the proxy
# sends and needs the three values below: the address the box is reached at, the secret the proxy
# sends with every request, and your own email, which the box's first user is given.
AUTH_MODE=
PUBLIC_BASE_URL=
TRUSTED_PROXY_SECRET=
OPERATOR_EMAIL=

# --- Limits ---------------------------------------------------------------------------------------

# Generations running at once across the box; 0 is no ceiling.
MAX_CONCURRENT_GENERATIONS=0

# Coding harnesses the box turns off, separated by commas or spaces (claude-code, codex, cursor,
# antigravity). They stay in the runtime image but are neither offered nor run. Empty offers every
# harness the image carries.
HARNESSES_OFF=

# --- Model catalog ----------------------------------------------------------------------------------

# Where the model catalog is fetched from, on the first read and again once an hour. Set empty to
# stay on the catalog snapshot the box ships with. Model keys are an organisation's own, under
# Settings, Model keys; the server holds none.
MODELS_DEV_URL=https://models.dev/api.json

# --- Development ------------------------------------------------------------------------------------

# The live model contract: a {provider}/{model} id, the key it runs with, and a local endpoint's URL.
MODEL_CONTRACT_MODEL=
MODEL_CONTRACT_API_KEY=
MODEL_CONTRACT_BASE_URL=
