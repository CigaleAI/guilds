class Cursor(Driver):
    name = "cursor"
    binary = "agent"
    # The Cursor CLI takes no prompt on stdin: its argument names the prompt file.
    prompt_on_stdin = False
    # It has no switch to ignore the configuration in the home; a repository's own `.cursor/`,
    # hooks included, still loads. Besides its own folder, it reads the rules of every folder
    # from the one it runs in up to the root: the home's and `repos/`'s too. It loads a workspace's
    # MCP server once an approval stored for that workspace names it, and skips one a workspace's
    # disabled list names: both go, so the only approval a call has is the one the driver gives.
    # It also loads the plugins of the account it runs on, fetched from Cursor's servers on every
    # start and kept out by no switch; a sign-in made in the home to one of their MCP servers goes,
    # so it does not reach the next call.
    local_state = (
        ".cursor/hooks.json",
        ".cursor/hooks",
        ".cursor/mcp.json",
        ".cursor/rules",
        ".cursor/skills",
        ".cursor/commands",
        ".cursor/agents",
        ".cursor/plugins",
        ".cursor/projects/*/mcp-approvals.json",
        ".cursor/projects/*/mcp-disabled.json",
        ".cursor/projects/*/mcp-auth.json",
        "AGENTS.md",
        "CLAUDE.md",
        "CLAUDE.local.md",
        "repos/.cursor/rules",
        "repos/AGENTS.md",
        "repos/CLAUDE.md",
        "repos/CLAUDE.local.md",
    )
    # Where it reads a user rule and a user MCP server, which apply wherever it runs: the call's
    # system prompt as a rule that always applies, and the call's MCP server, which a user
    # configuration gives without the approval a repository's own `.cursor/mcp.json` needs, except
    # in the home (`approve_mcp_server`).
    rules_file = Path(".cursor/rules/guilds.mdc")
    mcp_file = Path(".cursor/mcp.json")

    def command(self, session_id: str, files: TurnFiles, launch: Launch) -> list[str]:
        argv = [self.binary, "-p", "--force", "--trust", "--output-format", "stream-json"]
        argv += self.model_args(launch)
        if session_id:
            argv.append(f"--resume={session_id}")
        argv.append(f"Read your task in {files.prompt} and follow it.")
        return argv

    def system_prompt_file(self, run_id: str, call_id: str) -> Path:
        return HOME / self.rules_file

    def system_prompt_text(self, system_prompt: str) -> str:
        return f"---\ndescription: The guild's instructions for this turn\nalwaysApply: true\n---\n\n{system_prompt}"

    def system_prompt_args(self, path: Path) -> list[str]:
        # The CLI reads the rule where it lies, on top of its own system prompt.
        return []

    def mcp_config_file(self, run_id: str, call_id: str) -> Path:
        return HOME / self.mcp_file

    def mcp_config(self, server: McpServer) -> dict[str, Any]:
        # The reset removed any other server of the home's configuration first.
        headers = {"Authorization": f"Bearer {server.token}"}
        return {"mcpServers": {MCP_SERVER: {"url": server.url, "headers": headers}}}

    def mcp_config_args(self, path: Path) -> list[str]:
        return []

    def approve_mcp_server(self, cwd: Path, env: dict[str, str]) -> None:
        # In the home the user configuration is also the workspace's own, whose servers load only
        # on an approval. The CLI's approval names the server's exact configuration and this
        # workspace, so it covers the server just written and no repository's.
        if os.path.realpath(cwd) != os.path.realpath(HOME):
            return
        done = subprocess.run(
            [self.binary, "mcp", "enable", MCP_SERVER],
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=VERSION_TIMEOUT,
            env=env,
            check=False,
        )
        if done.returncode != 0:
            reason = _first_line(done.stderr) or _first_line(done.stdout) or f"exit {done.returncode}"
            raise ToolError(f"{self.binary} did not approve the {MCP_SERVER} MCP server: {reason}")

    def credential(self, env: dict[str, str]) -> str | None:
        if env.get("CURSOR_API_KEY"):
            return "secret"
        config = Path(env.get("XDG_CONFIG_HOME") or HOME / ".config")
        if (config / "cursor" / "auth.json").is_file():
            return "login"
        return None

    def account(self, env: dict[str, str]) -> str | None:
        config = Path(env.get("XDG_CONFIG_HOME") or HOME / ".config")
        return _text(_json_file(config / "cursor" / "auth.json").get("email"))

    def session(self, event: dict[str, Any]) -> str:
        value = event.get("session_id")
        return value if isinstance(value, str) else ""

    def progress(self, event: dict[str, Any]) -> list[str]:
        kind = event.get("type")
        if kind == "system" and event.get("subtype") == "init":
            model = event.get("model")
            return [f"started{f' on {model}' if isinstance(model, str) and model else ''}"]
        if kind == "assistant":
            texts = [
                part.get("text", "")
                for part in (event.get("message") or {}).get("content") or []
                if isinstance(part, dict) and part.get("type") == "text"
            ]
            line = _first_line("\n".join(texts))
            return [line] if line else []
        if kind == "tool_call" and event.get("subtype") == "started":
            call = event.get("tool_call") if isinstance(event.get("tool_call"), dict) else {}
            for key, body in call.items():
                args = body.get("args") if isinstance(body, dict) else None
                if key == "function" and isinstance(body, dict):
                    return [str(body.get("name") or "tool")]
                return [_tool_summary(CURSOR_TOOLS.get(key, key.removesuffix("ToolCall")), args)]
        return []

    def outcome(self, events: Iterator[dict[str, Any]]) -> dict[str, Any]:
        last_text = ""
        for event in events:
            if event.get("type") == "assistant":
                texts = [
                    part.get("text", "")
                    for part in (event.get("message") or {}).get("content") or []
                    if isinstance(part, dict) and part.get("type") == "text"
                ]
                if any(text.strip() for text in texts):
                    last_text = "\n".join(text for text in texts if text.strip())
            elif event.get("type") == "result":
                is_error = event.get("is_error") is True or event.get("subtype") not in (None, "success")
                result = event.get("result") if isinstance(event.get("result"), str) else ""
                # The result joins every assistant message; the last one carries the summary and any question.
                return {
                    "message": last_text or result,
                    "is_error": is_error,
                    "error": (result or str(event.get("subtype") or "")) if is_error else "",
                }
        return {"message": last_text, "is_error": True, "error": "the harness ended without a result"}


def _payload(event: dict[str, Any]) -> dict[str, Any]:
    """An Antigravity event's payload: the object under its event name, else the event itself."""
    body = event.get(str(event.get("event") or ""))
    return body if isinstance(body, dict) else event


class Antigravity(Driver):
    name = "antigravity"
    binary = "agy"
    # The prompt is one stream-json user message on stdin, which keeps it off the command line
    # and needs no workspace beside the repository: a directory added to the workspace becomes
    # the one its commands run in.
    prompt_on_stdin = True
    # Each would move it off the Google sign-in: a Gemini API key, Cloud credentials, or another endpoint.
    removed_env = (
        "GEMINI_API_KEY",
        "GOOGLE_GEMINI_BASE_URL",
        "AGY_ADC_AUTH",
        "AGY_LLM_GATEWAY_URL",
        "AGY_ACCOUNT",
        "GOOGLE_CLOUD_QUOTA_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
    )
    # The CLI's settings, written before every call over whatever the home holds: tools and plan
    # reviews proceed unattended, paid credits are never spent past the plan, and nothing is sent
    # beyond the turn.
    settings = {
        "toolPermission": "always-proceed",
        "artifactReviewPolicy": "always-proceed",
        "useG1Credits": False,
        "enableTelemetry": False,
        "showFeedbackSurvey": False,
    }
    settings_path = Path(".gemini/antigravity-cli/settings.json")
    # It has no switch to ignore the customisations in the home; a repository's own `.agents/`,
    # `GEMINI.md`, and `AGENTS.md` still load.
    local_state = (
        ".gemini/GEMINI.md",
        ".gemini/AGENTS.md",
        ".gemini/config/GEMINI.md",
        ".gemini/config/AGENTS.md",
        ".gemini/config/rules",
        ".gemini/config/hooks.json",
        ".gemini/config/mcp_config.json",
        ".gemini/config/skills",
        ".gemini/config/skills.json",
        ".gemini/config/plugins",
        ".gemini/config/plugins.json",
        ".gemini/config/workflows",
        ".gemini/config/workflows.json",
        ".gemini/config/global_workflows",
        ".gemini/config/sidecars",
    )

    def reset(self) -> list[str]:
        removed = super().reset()
        path = HOME / self.settings_path
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(self.settings), encoding="utf-8")
        return removed

    # Where it reads its global rules and its MCP servers, which apply wherever it runs: the call's
    # system prompt as a global rule, and the call's MCP server.
    rules_file = Path(".gemini/GEMINI.md")
    mcp_file = Path(".gemini/config/mcp_config.json")

    def command(self, session_id: str, files: TurnFiles, launch: Launch) -> list[str]:
        argv = [
            self.binary,
            "--output-format",
            "stream-json",
            "--input-format",
            "stream-json",
            "--dangerously-skip-permissions",
            "--disable-slash-commands",
        ]
        argv += self.model_args(launch)
        if session_id:
            argv += ["--conversation", session_id]
        return argv

    def prompt_text(self, prompt: str) -> str:
        return json.dumps({"event": "user", "message": {"content": prompt}}, ensure_ascii=False) + "\n"

    def system_prompt_file(self, run_id: str, call_id: str) -> Path:
        return HOME / self.rules_file

    def system_prompt_args(self, path: Path) -> list[str]:
        # The CLI reads the rule where it lies, on top of its own system prompt.
        return []

    def mcp_config_file(self, run_id: str, call_id: str) -> Path:
        return HOME / self.mcp_file

    def mcp_config(self, server: McpServer) -> dict[str, Any]:
        # The reset removed any other server of the home's configuration first.
        headers = {"Authorization": f"Bearer {server.token}"}
        return {"mcpServers": {MCP_SERVER: {"serverUrl": server.url, "headers": headers}}}

    def mcp_config_args(self, path: Path) -> list[str]:
        return []

    def effort_args(self, effort: str) -> list[str]:
        return ["--effort", effort]

    def credential(self, env: dict[str, str]) -> str | None:
        return "login" if (HOME / ANTIGRAVITY_TOKEN).is_file() else None

    def session(self, event: dict[str, Any]) -> str:
        # `init` carries the conversation beside its payload; every step update, inside its own.
        value = event.get("conversation_id") or _payload(event).get("conversation_id")
        return value if isinstance(value, str) else ""

    def progress(self, event: dict[str, Any]) -> list[str]:
        kind = event.get("event")
        body = _payload(event)
        if kind == "init":
            model = body.get("model")
            return [f"started{f' on {model}' if isinstance(model, str) and model else ''}"]
        if kind != "step_update" or body.get("state") != "DONE":
            return []
        if body.get("step_type") == "agent_response":
            line = _first_line(body.get("text") or "")
            return [line] if line else []
        if body.get("step_type") == "tool":
            info = body.get("tool_info") if isinstance(body.get("tool_info"), dict) else {}
            return [_tool_summary(str(info.get("name") or body.get("tool_name") or "tool"), info.get("parameters"))]
        return []

    def outcome(self, events: Iterator[dict[str, Any]]) -> dict[str, Any]:
        for event in events:
            if event.get("event") != "result":
                continue
            result = _payload(event)
            is_error = result.get("status") != "SUCCESS"
            error = result.get("error") if isinstance(result.get("error"), str) else ""
            return {
                "message": result.get("response") if isinstance(result.get("response"), str) else "",
                "is_error": is_error,
                "error": (error or str(result.get("status") or "")) if is_error else "",
            }
        return {"message": "", "is_error": True, "error": "the harness ended without a result"}


DRIVERS: dict[str, Driver] = {
    driver.name: driver for driver in (ClaudeCode(), Codex(), Cursor(), Antigravity())
}


def _json_file(path: Path) -> dict[str, Any]:
    """The JSON object in `path`, or an empty one when it is missing, unreadable, or not an object."""
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return loaded if isinstance(loaded, dict) else {}


def _jwt_claims(token: str) -> dict[str, Any]:
    """The claims of a JWT, read without checking its signature; empty when it does not parse."""
    parts = token.split(".")
    if len(parts) != 3:
        return {}
    payload = parts[1] + "=" * (-len(parts[1]) % 4)
    try:
        claims = json.loads(base64.urlsafe_b64decode(payload).decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return {}
    return claims if isinstance(claims, dict) else {}


def _text(value: Any) -> str | None:
    return value.strip() if isinstance(value, str) and value.strip() else None


def _toml_string(value: str) -> str:
    """A TOML basic string of `value`, as a `-c` override's value takes it."""
    return json.dumps(value)


def _driver(spec: dict[str, Any]) -> Driver:
    driver = DRIVERS.get(str(spec.get("harness") or ""))
    if driver is None:
        raise ToolError(f"unknown harness {spec.get('harness')!r}")
    return driver


# --- state ------------------------------------------------------------------


def _paths(call_id: str) -> dict[str, Path]:
    base = STATE / call_id
    return {
        "state": base.with_suffix(".json"),
        "pid": base.with_suffix(".pid"),
        "exit": base.with_suffix(".exit"),
        "session": base.with_suffix(".session"),
        "stderr": base.with_suffix(".stderr"),
    }


def _read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def _write(path: Path, text: str) -> None:
    temp = path.with_name(f".{path.name}.tmp")
    temp.write_text(text, encoding="utf-8")
    os.replace(temp, path)


def _load_state(call_id: str) -> dict[str, Any] | None:
    raw = _read(_paths(call_id)["state"])
    if not raw:
        return None
    try:
        state = json.loads(raw)
    except ValueError:
        return None
    return state if isinstance(state, dict) else None


def _int_file(path: Path) -> int | None:
    text = _read(path)
    try:
        return int(text)
    except ValueError:
        return None


def _group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def _pid_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return fields[0] != "Z"
    except (OSError, IndexError):
        return True


def _exit_code(call_id: str, state: dict[str, Any]) -> tuple[bool, int | None]:
    """Whether the CLI has exited, and its exit code when the supervisor recorded one."""
    paths = _paths(call_id)
    code = _int_file(paths["exit"])
    if code is not None:
        return True, code
    supervisor = state.get("supervisor_pid")
    if isinstance(supervisor, int) and not _pid_running(supervisor):
        code = _int_file(paths["exit"])
        return True, code
    return False, None


def _run_dir(run_id: str) -> Path:
    folder = RUNS / run_id
    if not folder.is_dir():
        folder.mkdir(parents=True, exist_ok=True)
        entries = []
        for entry in RUNS.iterdir():
            if entry.is_symlink() or not entry.is_dir():
                continue
            entries.append((entry.stat().st_mtime, entry))
        entries.sort(key=lambda item: item[0], reverse=True)
        for _, entry in entries[KEEP_RUNS:]:
            if entry != folder:
                shutil.rmtree(entry, ignore_errors=True)
    return folder


def _child_env(spec: dict[str, Any], driver: Driver) -> dict[str, str]:
    env = {key: value for key, value in os.environ.items() if key not in DROPPED_ENV}
    env.update(CHILD_ENV)
    for key, name in (("run_id", "GUILD_RUN_ID"), ("agent_id", "GUILD_AGENT_ID")):
        value = spec.get(key)
        if isinstance(value, str) and value:
            env[name] = value
    return driver.environment(env)


# --- ops --------------------------------------------------------------------


def _version(binary: str, env: dict[str, str]) -> str | None:
    try:
        done = subprocess.run(
            [binary, "--version"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=VERSION_TIMEOUT,
            env=env,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return _first_line(done.stdout or done.stderr) or None


def op_check(spec: dict[str, Any]) -> dict[str, Any]:
    driver = _driver(spec)
    binary = shutil.which(driver.binary)
    if binary is None:
        return {
            "text": f"{driver.binary} is not installed in this image",
            "meta": {"installed": False, "version": None, "credential": None},
        }
    env = _child_env(spec, driver)
    version = _version(binary, env)
    credential = driver.credential(env)
    account = driver.account(env) if credential == "login" else None
    text = f"{driver.binary} {version or '(unknown version)'}; credential: {credential or 'none'}"
    meta = {"installed": True, "version": version, "credential": credential, "account": account}
    return {"text": text, "meta": meta}


def _launch(spec: dict[str, Any]) -> Launch:
    """The model the harness runs and its effort, each empty for the harness's default, and its
    turn's limit on model calls, 0 for none."""
    model = spec.get("model") or ""
    if not isinstance(model, str) or (model and not MODEL_RE.fullmatch(model)):
        raise ToolError("model is invalid")
    effort = spec.get("effort") or ""
    if not isinstance(effort, str) or (effort and effort not in EFFORTS):
        raise ToolError("effort is invalid")
    max_turns = spec.get("max_turns") or 0
    if not isinstance(max_turns, int) or isinstance(max_turns, bool) or max_turns < 0:
        raise ToolError("max_turns is invalid")
    return Launch(model, effort, max_turns)


def _start_request(spec: dict[str, Any]) -> tuple[Driver, str, str, Path, str, str]:
    """The validated start request: driver, call id, run id, working directory, prompt, session id."""
    driver = _driver(spec)
    call_id = _safe_segment(spec.get("call_id"), "call_id")
    run_id = _safe_segment(spec.get("run_id"), "run_id")
    cwd = _working_dir(spec)
    prompt = spec.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        raise ToolError("prompt is required")
    return driver, call_id, run_id, cwd, prompt, _session_id(spec)


def _working_dir(spec: dict[str, Any]) -> Path:
    """The directory of the repository the request names, or the agent's home when it names none."""
    if not spec.get("repository"):
        return HOME
    repository = _safe_segment(spec.get("repository"), "repository")
    cwd = REPOS / repository
    if not cwd.is_dir():
        raise ToolError(f"no repository {repository} under {REPOS}")
    return cwd


def _system_prompt(spec: dict[str, Any]) -> str:
    """The system prompt the request starts the CLI with in place of its own; empty for none."""
    system_prompt = spec.get("system_prompt") or ""
    if not isinstance(system_prompt, str):
        raise ToolError("system_prompt is invalid")
    return system_prompt


def _mcp_server(spec: dict[str, Any]) -> McpServer | None:
    """The orchestrator's MCP server the request starts the CLI with; None when it names none.
    A URL comes with its token, and a token with its URL."""
    url = spec.get("mcp_url") or ""
    token = spec.get("mcp_token") or ""
    if not isinstance(url, str) or (url and not MCP_URL_RE.fullmatch(url)):
        raise ToolError("mcp_url is invalid")
    if not isinstance(token, str) or (token and not MCP_TOKEN_RE.fullmatch(token)):
        raise ToolError("mcp_token is invalid")
    if bool(url) != bool(token):
        raise ToolError("mcp_url and mcp_token go together")
    return McpServer(url, token) if url else None


def _session_id(spec: dict[str, Any]) -> str:
    session_id = spec.get("session_id") or ""
    if not isinstance(session_id, str) or (session_id and not re.fullmatch(r"[A-Za-z0-9_.:-]{1,200}", session_id)):
        raise ToolError("session_id is invalid")
    return session_id


def _claim_call(call_id: str) -> dict[str, Path]:
    """The call's state paths, cleared of an earlier call under the same id; refuses one still running."""
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    paths = _paths(call_id)
    existing = _load_state(call_id)
    if existing is not None and not _exit_code(call_id, existing)[0]:
        raise ToolError(f"call {call_id} is already running")
    for key in ("pid", "exit", "session", "stderr"):
        paths[key].unlink(missing_ok=True)
    return paths


def _write_private(path: Path, text: str) -> None:
    """Writes one of a call's private files, readable by its owner alone, in a folder made for it
    when it is missing."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)


def _launch_supervisor(spec: dict[str, Any], driver: Driver, call_id: str) -> int:
    env = _child_env(spec, driver)
    if "GUILDS_RUN_DIR" in os.environ:
        env["GUILDS_RUN_DIR"] = os.environ["GUILDS_RUN_DIR"]
    supervisor = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--supervise", call_id],
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    return supervisor.pid


def _wait_for_pid(paths: dict[str, Path]) -> int | None:
    """The CLI's pid once the supervisor started it, or None when it exited first or took too long."""
    deadline = time.monotonic() + START_WAIT
    while time.monotonic() < deadline and not paths["pid"].exists() and not paths["exit"].exists():
        time.sleep(0.05)
    return _int_file(paths["pid"])


def op_start(spec: dict[str, Any]) -> dict[str, Any]:
    driver, call_id, run_id, cwd, prompt, session_id = _start_request(spec)
    launch = _launch(spec)
    system_prompt = _system_prompt(spec)
    mcp = _mcp_server(spec)
    files = TurnFiles(
        RUNS / run_id / f"{call_id}.prompt.md",
        driver.system_prompt_file(run_id, call_id) if system_prompt else None,
        driver.mcp_config_file(run_id, call_id) if mcp else None,
    )
    # Refuses an effort or a turn limit the harness cannot take before anything is claimed or reset.
    driver.model_args(launch)
    if shutil.which(driver.binary) is None:
        raise ToolError(f"{driver.binary} is not installed in this image")
    paths = _claim_call(call_id)
    # The reset comes first: it removes what an earlier call left where this one writes.
    reset = driver.reset()
    run_dir = _run_dir(run_id)
    _write_private(files.prompt, driver.prompt_text(prompt))
    if files.system:
        _write_private(files.system, driver.system_prompt_text(system_prompt))
    if files.mcp and mcp:
        _write_private(files.mcp, json.dumps(driver.mcp_config(mcp)))
        driver.approve_mcp_server(cwd, _child_env(spec, driver))
    state = {
        "call_id": call_id,
        "run_id": run_id,
        "harness": driver.name,
        "repository": cwd.name if cwd != HOME else None,
        "cwd": str(cwd),
        "argv": driver.command(session_id, files, launch),
        "stdin": str(files.prompt) if driver.prompt_on_stdin else None,
        "prompt_path": str(files.prompt),
        "system_prompt_path": str(files.system) if files.system else None,
        "mcp_config_path": str(files.mcp) if files.mcp else None,
        "log_path": str(run_dir / f"{call_id}.harness.jsonl"),
        "started_at": time.time(),
        "supervisor_pid": None,
    }
    _write(paths["state"], json.dumps(state))
    state["supervisor_pid"] = _launch_supervisor(spec, driver, call_id)
    _write(paths["state"], json.dumps(state))
    pid = _wait_for_pid(paths)
    exited, code = _exit_code(call_id, state)
    text = f"started {driver.name} in {cwd}" + (f" (pid {pid})" if pid else "")
    meta = {"pid": pid, "log_path": state["log_path"], "exited": exited and pid is None, "exit_code": code, "reset": reset}
    return {"text": text, "meta": meta}


def _run_cli(state: dict[str, Any], out: Any, err: Any) -> int:
    """Starts the CLI in its own process group with its output in the log; returns its exit code."""
    stdin_path = state.get("stdin")
    env = {key: value for key, value in os.environ.items() if key not in DROPPED_ENV}
    if state.get("mcp_config_path"):
        env.update(_driver(state).mcp_env(Path(state["mcp_config_path"])))
    stdin = open(stdin_path, "rb") if stdin_path else subprocess.DEVNULL
    try:
        child = subprocess.Popen(
            state["argv"],
            cwd=state["cwd"],
            env=env,
            stdin=stdin,
            stdout=out,
            stderr=err,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as exc:
        err.write(f"{state['argv'][0]}: {exc.strerror or exc}\n".encode("utf-8"))
        return 127
    finally:
        if stdin is not subprocess.DEVNULL:
            stdin.close()
    _write(_paths(state["call_id"])["pid"], str(child.pid))
    return child.wait()


def supervise(call_id: str) -> None:
    """The supervisor: runs the CLI and records how it exits."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    paths = _paths(call_id)
    state = _load_state(call_id)
    if state is None:
        return
    code = 127
    try:
        with Path(state["log_path"]).open("ab") as out, paths["stderr"].open("wb") as err:
            code = _run_cli(state, out, err)
    finally:
        _write(paths["exit"], str(code))


def _read_log(path: Path, start: int | None, complete: bool) -> bytes:
    """The log's bytes: at most POLL_MAX_BYTES from `start`, or all of it when `start` is None;
    through the last complete line, or through the end when `complete` and nothing more follows."""
    try:
        with path.open("rb") as handle:
            handle.seek(start or 0)
            data = handle.read() if start is None else handle.read(POLL_MAX_BYTES)
            at_end = handle.read(1) == b""
    except OSError:
        return b""
    if complete and at_end:
        return data
    return data[: data.rfind(b"\n") + 1]


def _parse_events(data: bytes) -> tuple[list[dict[str, Any]], int]:
    """The JSON object lines in `data`, and how many non-blank lines were not one."""
    events: list[dict[str, Any]] = []
    unparsed = 0
    for raw in data.splitlines():
        event = _json_line(raw)
        if isinstance(event, dict):
            events.append(event)
        elif event is not None:
            unparsed += 1
    return events, unparsed


def _json_line(raw: bytes) -> Any:
    """The line's JSON value, None for a blank line, or False when it is not JSON."""
    if not raw.strip():
        return None
    try:
        return json.loads(raw)
    except ValueError:
        return False


def _events(path: Path, complete: bool, start: int | None = None) -> tuple[list[dict[str, Any]], int, int]:
    """The JSON events in the log (see `_read_log`), the new offset, and how many lines were not JSON."""
    data = _read_log(path, start, complete)
    events, unparsed = _parse_events(data)
    return events, (start or 0) + len(data), unparsed


def _remember_session(call_id: str, driver: Driver, events: list[dict[str, Any]]) -> str:
    path = _paths(call_id)["session"]
    known = _read(path)
    if known:
        return known
    for event in events:
        found = driver.session(event)
        if found:
            _write(path, found)
            return found
    return ""


def _progress_lines(driver: Driver, events: list[dict[str, Any]]) -> list[str]:
    """The events' progress as whole lines, which the orchestrator redacts and then clips; the
    last POLL_MAX_LINES of them."""
    lines = [" ".join(line.split()) for event in events for line in driver.progress(event) if line.strip()]
    dropped = len(lines) - POLL_MAX_LINES
    return [f"… {dropped} more steps"] + lines[-POLL_MAX_LINES:] if dropped > 0 else lines


def _log_read_through(log: Path, offset: int) -> bool:
    return offset >= (log.stat().st_size if log.exists() else 0)


def op_poll(spec: dict[str, Any]) -> dict[str, Any]:
    driver = _driver(spec)
    call_id = _safe_segment(spec.get("call_id"), "call_id")
    state = _load_state(call_id)
    if state is None:
        return {"text": f"no harness call {call_id}", "meta": {"missing": True}}
    offset = spec.get("offset")
    start = offset if isinstance(offset, int) and offset >= 0 else 0
    exited, code = _exit_code(call_id, state)
    log = Path(state["log_path"])
    data = _read_log(log, start, exited)
    events, _ = _parse_events(data)
    new_offset = start + len(data)
    lines = _progress_lines(driver, events)
    meta = {
        "missing": False,
        "offset": new_offset,
        "lines": lines,
        "session_id": _remember_session(call_id, driver, events) or None,
        # A CLI that exited is not done until its whole log is read.
        "exited": exited and _log_read_through(log, new_offset),
        "exit_code": code,
    }
    return {"text": data.decode("utf-8", errors="replace"), "meta": meta}


def _stderr_tail(path: Path) -> str:
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            handle.seek(max(0, handle.tell() - STDERR_TAIL_BYTES))
            return handle.read().decode("utf-8", errors="replace").strip()
    except OSError:
        return ""


def _clear_call(state: dict[str, Any], paths: dict[str, Path]) -> None:
    """Removes the call's state files and its private files."""
    for private in (state.get("prompt_path"), state.get("system_prompt_path"), state.get("mcp_config_path")):
        if private:
            Path(private).unlink(missing_ok=True)
    for path in paths.values():
        path.unlink(missing_ok=True)


def op_result(spec: dict[str, Any]) -> dict[str, Any]:
    driver = _driver(spec)
    call_id = _safe_segment(spec.get("call_id"), "call_id")
    state = _load_state(call_id)
    if state is None:
        return {"text": f"no harness call {call_id}", "meta": {"missing": True}}
    paths = _paths(call_id)
    exited, code = _exit_code(call_id, state)
    events, _, unparsed = _events(Path(state["log_path"]), exited)
    outcome = driver.outcome(iter(events))
    meta = {
        "missing": False,
        "exited": exited,
        "exit_code": code,
        "session_id": _remember_session(call_id, driver, events) or None,
        "message": outcome.get("message") or "",
        "is_error": bool(outcome.get("is_error")),
        "error": outcome.get("error") or "",
        "max_turns": bool(outcome.get("max_turns")),
        "events": len(events),
        "unparsed": unparsed,
        "stderr": _stderr_tail(paths["stderr"]),
        "log_path": state["log_path"],
        "duration_ms": int((time.time() - float(state.get("started_at") or time.time())) * 1000),
    }
    if exited:
        _clear_call(state, paths)
    return {"text": meta["message"], "meta": meta}


def _signal_group(pgid: int, sig: int, wait: float) -> bool:
    """Sends `sig` to the process group and waits up to `wait` seconds; whether the group is gone."""
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        return True
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline and _group_alive(pgid):
        time.sleep(0.1)
    return not _group_alive(pgid)


def _end_group(pgid: int | None) -> None:
    """SIGTERM to the CLI's process group, then SIGKILL once the grace period is over."""
    if pgid is not None and not _signal_group(pgid, signal.SIGTERM, STOP_GRACE):
        _signal_group(pgid, signal.SIGKILL, 1.0)


def _wait_for_exit(call_id: str, state: dict[str, Any]) -> tuple[bool, int | None]:
    """Waits for the supervisor to record the exit; whether it did, and the exit code."""
    deadline = time.monotonic() + EXIT_WAIT
    while time.monotonic() < deadline and not _exit_code(call_id, state)[0]:
        time.sleep(0.05)
    return _exit_code(call_id, state)


def op_stop(spec: dict[str, Any]) -> dict[str, Any]:
    call_id = _safe_segment(spec.get("call_id"), "call_id")
    state = _load_state(call_id)
    if state is None:
        return {"text": f"no harness call {call_id}", "meta": {"missing": True}}
    paths = _paths(call_id)
    exited, code = _exit_code(call_id, state)
    if not exited:
        _end_group(_int_file(paths["pid"]))
        exited, code = _wait_for_exit(call_id, state)
    meta = {
        "missing": False,
        "exited": exited,
        "exit_code": code,
        "session_id": _read(paths["session"]) or None,
        "log_path": state.get("log_path"),
    }
    return {"text": f"stopped {call_id}" if exited else f"{call_id} did not stop", "meta": meta}


OPS = {
    "check": op_check,
    "start": op_start,
    "poll": op_poll,
    "result": op_result,
    "stop": op_stop,
}


def main() -> None:
    if len(sys.argv) == 3 and sys.argv[1] == "--supervise":
        supervise(_safe_segment(sys.argv[2], "call_id"))
        return
    try:
        spec = _request()
        handler = OPS.get(str(spec.get("op")))
        if handler is None:
            raise ToolError(f"unknown op {spec.get('op')}")
        result = handler(spec)
        _emit({"ok": True, "text": result["text"], "meta": result.get("meta", {})})
    except ToolError as exc:
        _emit({"ok": False, "error": str(exc)})
    except subprocess.TimeoutExpired as exc:
        _emit({"ok": False, "error": f"timed out after {exc.timeout}s"})
    except OSError as exc:
        _emit({"ok": False, "error": f"{exc.strerror or exc}: {exc.filename or ''}".rstrip(": ")})
    except Exception as exc:  # noqa: BLE001 - every failure answers as an envelope
        _emit({"ok": False, "error": f"{type(exc).__name__}: {exc}"})


if __name__ == "__main__":
    main()
