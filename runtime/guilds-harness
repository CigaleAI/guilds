class ToolError(Exception):
    pass


class Launch(NamedTuple):
    """The model and effort a call starts the CLI with, empty to leave each to the harness, and
    the most model calls its turn may make, 0 for no limit."""

    model: str
    effort: str
    max_turns: int


class McpServer(NamedTuple):
    """The orchestrator's MCP server a call starts the CLI with: its URL, and the token it takes."""

    url: str
    token: str


class TurnFiles(NamedTuple):
    """A call's private files the CLI reads: its prompt, and its system prompt and MCP
    configuration when the call has them."""

    prompt: Path
    system: Path | None
    mcp: Path | None


# --- request and envelope -------------------------------------------------


def _request() -> dict[str, Any]:
    if len(sys.argv) != 2:
        raise ToolError("usage: guilds-harness <base64-json> | guilds-harness @<file>")
    arg = sys.argv[1]
    if arg.startswith("@"):
        path = Path(arg[1:])
        try:
            raw = path.read_bytes()
        finally:
            path.unlink(missing_ok=True)
        loaded = json.loads(raw)
    else:
        loaded = json.loads(base64.b64decode(arg))
    if not isinstance(loaded, dict):
        raise ToolError("request must be an object")
    return loaded


def _emit(envelope: dict[str, Any]) -> None:
    body = json.dumps(envelope, ensure_ascii=False).encode("utf-8")
    sys.stdout.write(base64.b64encode(body).decode("ascii"))
    sys.stdout.flush()


def _safe_segment(value: Any, name: str) -> str:
    text = str(value or "")
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", text) or text in {".", ".."}:
        raise ToolError(f"{name} is invalid")
    return text


def _first_line(text: str) -> str:
    for line in str(text).splitlines():
        if line.strip():
            return line.strip()
    return ""


# --- drivers ----------------------------------------------------------------


class Driver:
    """Turns a task into a command line, and an event log into progress lines and a result."""

    name = ""
    binary = ""
    # Variables that would move the harness from the subscription to metered API billing.
    removed_env: tuple[str, ...] = ()
    added_env: dict[str, str] = {}
    prompt_on_stdin = True
    # The harness's own configuration and memory in the agent's home, as globs: removed before
    # every call, so the brief is the only state the agent hands it. The harness's own login,
    # account state, and session transcripts (which a resume needs) are never in it.
    local_state: tuple[str, ...] = ()

    def reset(self) -> list[str]:
        """Removes the harness's local configuration and memory; returns what it removed."""
        removed = []
        home = Path(os.path.realpath(HOME))
        for pattern in self.local_state:
            for found in sorted(HOME.glob(pattern)):
                real = Path(os.path.realpath(found))
                if home not in real.parents:
                    continue
                if found.is_dir() and not found.is_symlink():
                    shutil.rmtree(found, ignore_errors=True)
                else:
                    found.unlink(missing_ok=True)
                removed.append(str(found.relative_to(HOME)))
        return removed

    def command(self, session_id: str, files: TurnFiles, launch: Launch) -> list[str]:
        """The CLI's command line; an empty model leaves the model to the subscription, a system
        prompt file replaces the CLI's own system prompt, and an MCP configuration file is the
        only MCP server it uses."""
        raise NotImplementedError

    def effort_args(self, effort: str) -> list[str]:
        """The arguments that set the model's effort."""
        raise ToolError(f"{self.name} takes its effort in the model name")

    def prompt_text(self, prompt: str) -> str:
        """What the call's prompt file holds: the prompt as the CLI reads it."""
        return prompt

    def system_prompt_file(self, run_id: str, call_id: str) -> Path:
        """Where the call's system prompt file goes: a private file in the run folder, which the
        command line names."""
        return RUNS / run_id / f"{call_id}.system.md"

    def system_prompt_text(self, system_prompt: str) -> str:
        """What the call's system prompt file holds."""
        return system_prompt

    def system_prompt_args(self, path: Path) -> list[str]:
        """The arguments that give the CLI the system prompt of the file at `path`."""
        raise NotImplementedError

    def mcp_config_file(self, run_id: str, call_id: str) -> Path:
        """Where the call's MCP configuration file goes: a private file in the run folder."""
        return RUNS / run_id / f"{call_id}.mcp.json"

    def mcp_config(self, server: McpServer) -> dict[str, Any]:
        """The MCP configuration file's content that gives the CLI `server`, and no other."""
        raise NotImplementedError

    def mcp_config_args(self, path: Path) -> list[str]:
        """The arguments that give the CLI the MCP servers of the configuration file at `path`."""
        raise NotImplementedError

    def mcp_env(self, path: Path) -> dict[str, str]:
        """The variables the CLI alone is started with for the MCP configuration file at `path`;
        none for a CLI that reads the file itself."""
        return {}

    def approve_mcp_server(self, cwd: Path, env: dict[str, str]) -> None:
        """Approves the call's MCP server, once its configuration is written, for a CLI that loads
        it in `cwd` only on an approval; nothing for one that asks none there."""
        return None

    def max_turns_args(self, max_turns: int) -> list[str]:
        """The arguments that end the turn after `max_turns` model calls."""
        raise ToolError(f"{self.name} takes no turn limit")

    def model_args(self, launch: Launch) -> list[str]:
        """`--model` with the model, then the effort's arguments, then the turn limit's; nothing
        for what is empty."""
        argv = ["--model", launch.model] if launch.model else []
        argv += self.effort_args(launch.effort) if launch.effort else []
        return argv + (self.max_turns_args(launch.max_turns) if launch.max_turns else [])

    def credential(self, env: dict[str, str]) -> str | None:
        """`secret` or `login` when the harness has a credential to run on, else None."""
        raise NotImplementedError

    def account(self, env: dict[str, str]) -> str | None:
        """Who the login in the home belongs to, as the harness recorded it; None when unknown."""
        return None

    def session(self, event: dict[str, Any]) -> str:
        raise NotImplementedError

    def progress(self, event: dict[str, Any]) -> list[str]:
        raise NotImplementedError

    def outcome(self, events: Iterator[dict[str, Any]]) -> dict[str, Any]:
        """The turn's final message, whether it ended in error, and the error text."""
        raise NotImplementedError

    def environment(self, base: dict[str, str]) -> dict[str, str]:
        env = {key: value for key, value in base.items() if key not in self.removed_env}
        env.update(self.added_env)
        return env


def _tool_summary(name: str, arguments: Any) -> str:
    if not isinstance(arguments, dict):
        return name
    for key in ("command", "file_path", "path", "pattern", "url", "description", "query"):
        value = arguments.get(key)
        if isinstance(value, str) and value:
            return f"{name}: {_first_line(value)}"
    return name


class ClaudeCode(Driver):
    name = "claude-code"
    binary = "claude"
    removed_env = (
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL",
        "CLAUDE_CODE_USE_BEDROCK",
        "CLAUDE_CODE_USE_VERTEX",
    )
    # Commands run as root (SEC-6): Claude Code bypasses permissions as root only in a sandbox.
    added_env = {
        "IS_SANDBOX": "1",
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    }
    # The only settings a call loads, beside /etc/claude-code/managed-settings.json.
    settings = {
        "disableAllHooks": True,
        "enableAllProjectMcpServers": False,
        "autoMemoryEnabled": False,
        "enabledPlugins": {},
    }
    local_state = (
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/CLAUDE.md",
        ".claude/CLAUDE.local.md",
        ".claude/rules",
        ".claude/hooks",
        ".claude/plugins",
        ".claude/skills",
        ".claude/commands",
        ".claude/agents",
        ".claude/output-styles",
        ".claude/projects/*/memory",
    )

    def command(self, session_id: str, files: TurnFiles, launch: Launch) -> list[str]:
        argv = [
            self.binary,
            "-p",
            "--output-format",
            "stream-json",
            "--verbose",
            "--dangerously-skip-permissions",
            "--setting-sources",
            "",
            "--strict-mcp-config",
            "--disable-slash-commands",
            "--settings",
            json.dumps(self.settings),
        ]
        argv += self.system_prompt_args(files.system) if files.system else []
        argv += self.mcp_config_args(files.mcp) if files.mcp else []
        argv += self.model_args(launch)
        if session_id:
            argv += ["--resume", session_id]
        return argv

    def effort_args(self, effort: str) -> list[str]:
        return ["--effort", effort]

    def max_turns_args(self, max_turns: int) -> list[str]:
        return ["--max-turns", str(max_turns)]

    def system_prompt_args(self, path: Path) -> list[str]:
        return ["--system-prompt-file", str(path)]

    def mcp_config(self, server: McpServer) -> dict[str, Any]:
        return {
            "mcpServers": {
                MCP_SERVER: {
                    "type": "http",
                    "url": server.url,
                    "headers": {"Authorization": f"Bearer {server.token}"},
                }
            }
        }

    def mcp_config_args(self, path: Path) -> list[str]:
        # `--strict-mcp-config` keeps every other MCP configuration out.
        return ["--mcp-config", str(path)]

    def credential(self, env: dict[str, str]) -> str | None:
        if env.get("CLAUDE_CODE_OAUTH_TOKEN"):
            return "secret"
        if (HOME / ".claude" / ".credentials.json").is_file():
            return "login"
        return None

    def account(self, env: dict[str, str]) -> str | None:
        account = _json_file(HOME / ".claude.json").get("oauthAccount")
        return _text(account.get("emailAddress")) if isinstance(account, dict) else None

    def session(self, event: dict[str, Any]) -> str:
        value = event.get("session_id")
        return value if isinstance(value, str) else ""

    def progress(self, event: dict[str, Any]) -> list[str]:
        kind = event.get("type")
        if kind == "system" and event.get("subtype") == "init":
            model = event.get("model")
            return [f"started{f' on {model}' if isinstance(model, str) and model else ''}"]
        if kind != "assistant":
            return []
        lines = []
        for part in (event.get("message") or {}).get("content") or []:
            if not isinstance(part, dict):
                continue
            if part.get("type") == "text" and _first_line(part.get("text", "")):
                lines.append(_first_line(part["text"]))
            elif part.get("type") == "tool_use":
                lines.append(_tool_summary(str(part.get("name") or "tool"), part.get("input")))
        return lines

    def outcome(self, events: Iterator[dict[str, Any]]) -> dict[str, Any]:
        last_text = ""
        for event in events:
            if event.get("type") == "result":
                message = event.get("result")
                is_error = event.get("is_error") is True or event.get("subtype") not in (None, "success")
                text = message if isinstance(message, str) else ""
                return {
                    "message": text or last_text,
                    "is_error": is_error,
                    "error": (text or str(event.get("subtype") or "")) if is_error else "",
                    "max_turns": event.get("subtype") == "error_max_turns",
                }
            if event.get("type") == "assistant":
                texts = [
                    part.get("text", "")
                    for part in (event.get("message") or {}).get("content") or []
                    if isinstance(part, dict) and part.get("type") == "text"
                ]
                if any(text.strip() for text in texts):
                    last_text = "\n".join(text for text in texts if text.strip())
        return {"message": last_text, "is_error": True, "error": "the harness ended without a result"}


class Codex(Driver):
    name = "codex"
    binary = "codex"
    removed_env = ("CODEX_API_KEY", "OPENAI_API_KEY")
    # config.toml and execution-policy rules in the agent's home are not loaded; memories, hooks,
    # plugins, apps, MCP servers, notifications, update checks, and analytics are off.
    managed = (
        "--ignore-user-config",
        "--ignore-rules",
        "--disable",
        "memories",
        "--disable",
        "hooks",
        "--disable",
        "plugins",
        "--disable",
        "apps",
        "--disable",
        "in_app_updates",
        "-c",
        "mcp_servers={}",
        "-c",
        "notify=[]",
        "-c",
        "check_for_update_on_startup=false",
        "-c",
        "analytics.enabled=false",
        "-c",
        'otel.exporter="none"',
    )

    local_state = (
        ".codex/AGENTS.md",
        ".codex/AGENTS.override.md",
        ".codex/skills",
        ".codex/prompts",
        ".codex/rules",
        ".codex/memories",
        ".codex/memories_*.sqlite*",
        ".codex/hooks.json",
    )

    def command(self, session_id: str, files: TurnFiles, launch: Launch) -> list[str]:
        argv = [self.binary, "exec"]
        if session_id:
            argv.append("resume")
        argv += ["--json", "--dangerously-bypass-approvals-and-sandbox", *self.managed]
        argv += self.system_prompt_args(files.system) if files.system else []
        argv += self.mcp_config_args(files.mcp) if files.mcp else []
        argv += self.model_args(launch)
        if session_id:
            argv.append(session_id)
        # The prompt is read from stdin.
        argv.append("-")
        return argv

    def effort_args(self, effort: str) -> list[str]:
        return ["-c", f'model_reasoning_effort="{effort}"']

    def system_prompt_args(self, path: Path) -> list[str]:
        # Codex's own base instructions give way to the file; a rule file would only add to them.
        return ["-c", f"model_instructions_file={_toml_string(str(path))}"]

    def mcp_config(self, server: McpServer) -> dict[str, Any]:
        # Codex takes an MCP server from its configuration alone, so the file holds what the
        # call's overrides and the CLI's environment give it.
        return {"url": server.url, "token": server.token}

    def mcp_config_args(self, path: Path) -> list[str]:
        # `mcp_servers={}` among the managed overrides drops every other server first.
        server = f"mcp_servers.{MCP_SERVER}"
        return [
            "-c",
            f"{server}.url={_toml_string(str(_json_file(path).get('url') or ''))}",
            "-c",
            f"{server}.bearer_token_env_var={_toml_string(CODEX_MCP_TOKEN_ENV)}",
            # Codex hands its whole environment to the commands its model runs unless told otherwise.
            "-c",
            f"shell_environment_policy.exclude=[{_toml_string(CODEX_MCP_TOKEN_ENV)}]",
        ]

    def mcp_env(self, path: Path) -> dict[str, str]:
        token = _json_file(path).get("token")
        return {CODEX_MCP_TOKEN_ENV: token} if isinstance(token, str) and token else {}

    def credential(self, env: dict[str, str]) -> str | None:
        """A ChatGPT login: auth.json holding tokens, not only an API key."""
        home = Path(env.get("CODEX_HOME") or HOME / ".codex")
        try:
            auth = json.loads((home / "auth.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None
        tokens = auth.get("tokens") if isinstance(auth, dict) else None
        return "login" if isinstance(tokens, dict) and tokens else None

    def account(self, env: dict[str, str]) -> str | None:
        home = Path(env.get("CODEX_HOME") or HOME / ".codex")
        tokens = _json_file(home / "auth.json").get("tokens")
        id_token = tokens.get("id_token") if isinstance(tokens, dict) else None
        return _text(_jwt_claims(id_token).get("email")) if isinstance(id_token, str) else None

    def session(self, event: dict[str, Any]) -> str:
        value = event.get("thread_id") if event.get("type") == "thread.started" else None
        return value if isinstance(value, str) else ""

    def progress(self, event: dict[str, Any]) -> list[str]:
        kind = event.get("type")
        item = event.get("item") if isinstance(event.get("item"), dict) else {}
        if kind == "thread.started":
            return ["started"]
        if kind == "item.started" and item.get("type") == "command_execution":
            return [f"shell: {_first_line(str(item.get('command') or ''))}"]
        if kind != "item.completed":
            return []
        if item.get("type") == "file_change":
            return [
                f"{change.get('kind') or 'change'}: {change.get('path')}"
                for change in item.get("changes") or []
                if isinstance(change, dict) and change.get("path")
            ]
        if item.get("type") == "agent_message" and _first_line(item.get("text", "")):
            return [_first_line(item["text"])]
        if item.get("type") == "mcp_tool_call":
            return [f"tool: {item.get('server')}.{item.get('tool')}"]
        if item.get("type") == "web_search":
            return [f"search: {_first_line(str(item.get('query') or ''))}"]
        return []

    def outcome(self, events: Iterator[dict[str, Any]]) -> dict[str, Any]:
        message = ""
        ended: dict[str, Any] | None = None
        for event in events:
            item = event.get("item") if isinstance(event.get("item"), dict) else {}
            if event.get("type") == "item.completed" and item.get("type") == "agent_message":
                message = str(item.get("text") or "")
            elif event.get("type") == "turn.completed":
                ended = {"message": message, "is_error": False, "error": ""}
            elif event.get("type") == "turn.failed":
                error = (event.get("error") or {}).get("message") if isinstance(event.get("error"), dict) else None
                ended = {"message": message, "is_error": True, "error": str(error or "the turn failed")}
        return ended or {"message": message, "is_error": True, "error": "the harness ended without a result"}


