#!/usr/bin/env python3
"""git credential helper: the installation token of the guild repository git is talking to.

The orchestrator writes each agent's tokens to /run/guilds/<agent id>/git-tokens.json,
outside every home, at each generation start. The agent is the one whose home
GUILDS_AGENT_HOME names; git asks with the host and, through credential.useHttpPath,
the repository path.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

RUN_DIR = Path(os.environ.get("GUILDS_RUN_DIR", "/run/guilds"))


def _tokens() -> Path | None:
    home = os.environ.get("GUILDS_AGENT_HOME", "")
    name = Path(home).name if home else ""
    return RUN_DIR / name / "git-tokens.json" if name else None


def _request() -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in sys.stdin.read().splitlines():
        key, sep, value = line.partition("=")
        if sep:
            fields[key] = value
    return fields


def _normal(path: str) -> str:
    path = path.strip("/")
    return (path[:-4] if path.endswith(".git") else path).lower()


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return
    request = _request()
    tokens = _tokens()
    if tokens is None:
        return
    try:
        entries = json.loads(tokens.read_text(encoding="utf-8")).get("repositories") or {}
    except (OSError, ValueError, AttributeError):
        return
    host = request.get("host", "").lower()
    path = _normal(request.get("path", ""))
    for entry in entries.values():
        if not isinstance(entry, dict):
            continue
        if entry.get("host", "").lower() == host and _normal(str(entry.get("path", ""))) == path:
            sys.stdout.write(f"username=x-access-token\npassword={entry.get('token', '')}\n")
            return


if __name__ == "__main__":
    main()
