#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: guilds-script-run <script.py>")
    payload = os.environ.get("GUILDS_SCRIPT_ARGS", "{}")
    completed = subprocess.run(
        [sys.executable, sys.argv[1]],
        input=payload,
        text=True,
        env=os.environ,
    )
    raise SystemExit(completed.returncode)


if __name__ == "__main__":
    main()
