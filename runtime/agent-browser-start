#!/bin/bash
# Usage: agent-browser-start <agent id> <display> <vnc port> <devtools port> <cdp relay port> <novnc port> <language>
#
# Starts one agent's browser on its machine when it is not already answering: an Xtigervnc
# display, Chrome with the agent's profile and DevTools port on loopback, websockify serving
# noVNC, and gost relaying the DevTools port from every interface on the relay port, with the
# Host of each request set to Chrome's loopback address so Chrome serves it. The
# orchestrator passes the display and ports its slot sets, so every agent on the machine has its
# own. Prints the noVNC and DevTools ports once noVNC, DevTools, and the relay answer.
# Idempotent: a second call on a live browser prints the same; two calls at once take turns.
set -euo pipefail
source "${BASH_SOURCE[0]%/*}/../lib/guilds/agent-lib.sh"

AGENT="${1:-}"
DISPLAY_NUM="${2:-}"
VNC_PORT="${3:-}"
CDP_PORT="${4:-}"
RELAY_PORT="${5:-}"
NOVNC_PORT="${6:-}"
LANGUAGE="${7:-en-US}"
if ! valid_agent "$AGENT" || ! valid_display "$DISPLAY_NUM" || ! valid_port "$VNC_PORT" \
  || ! valid_port "$CDP_PORT" || ! valid_port "$RELAY_PORT" || ! valid_port "$NOVNC_PORT" \
  || [[ ! "$LANGUAGE" =~ ^[A-Za-z0-9-]{2,16}$ ]]; then
  echo "usage: agent-browser-start <agent id> <display> <vnc port> <devtools port> <cdp relay port> <novnc port> <language>" >&2
  exit 2
fi

HOME_DIR="/home/${AGENT}"
RUN_DIR="/run/guilds/${AGENT}"
PROFILE="${HOME_DIR}/.browser"
GEOMETRY="${BROWSER_GEOMETRY:-1280x720}"
NOVNC_ROOT=/usr/share/novnc
LOG="${RUN_DIR}/browser.log"
PID_FILE="${RUN_DIR}/browser.pid"
READY_TENTHS=600

ready() {
  curl -sf -o /dev/null "http://127.0.0.1:${NOVNC_PORT}/vnc.html" \
    && curl -sf -o /dev/null "http://127.0.0.1:${CDP_PORT}/json/version" \
    && curl -sf -o /dev/null "http://127.0.0.1:${RELAY_PORT}/json/version"
}

resolve_chrome() {
  if command -v google-chrome >/dev/null 2>&1; then
    echo google-chrome
  elif command -v google-chrome-stable >/dev/null 2>&1; then
    echo google-chrome-stable
  elif command -v chromium >/dev/null 2>&1; then
    echo chromium
  else
    echo "no chrome binary" >&2
    exit 1
  fi
}

# Keep cookies and logins; drop last-session tabs so Chrome does not reopen guilds.run.
clear_restored_tabs() {
  local default="${PROFILE}/Default"
  rm -f \
    "$default/Current Session" \
    "$default/Current Tabs" \
    "$default/Last Session" \
    "$default/Last Tabs"
  rm -rf "$default/Sessions"
}

clear_stale_chromium_locks() {
  local name path target
  for name in SingletonLock SingletonCookie SingletonSocket; do
    path="${PROFILE}/${name}"
    if [ -e "$path" ] || [ -L "$path" ]; then
      target=$(readlink "$path" 2>/dev/null || true)
      echo "clearing stale chromium $name${target:+ -> $target}"
      rm -f "$path"
    fi
  done
}

# A display lock whose server is gone; a live server's lock stays, and Xtigervnc then fails.
clear_stale_display_lock() {
  local lock="/tmp/.X${DISPLAY_NUM}-lock" owner
  [ -e "$lock" ] || return 0
  owner="$(tr -d ' \n' < "$lock" 2>/dev/null || true)"
  if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
    return 0
  fi
  rm -f "$lock" "/tmp/.X11-unix/X${DISPLAY_NUM}"
}

# The supervisor: the display, the window manager, noVNC, the DevTools relay, and Chrome,
# restarted when it exits.
# It leads its own process group, which agent-stop ends as one.
supervise() {
  export DISPLAY=":${DISPLAY_NUM}"
  export HOME="$HOME_DIR"
  export GUILDS_AGENT_HOME="$HOME_DIR"
  export GUILDS_BROWSER_LANGUAGE="$LANGUAGE"
  export GUILDS_LOCALE_CACHE="${RUN_DIR}/locale.json"
  trap 'jobs -p | xargs -r kill 2>/dev/null || true' EXIT

  clear_stale_display_lock
  Xtigervnc ":${DISPLAY_NUM}" \
    -geometry "$GEOMETRY" \
    -depth 24 \
    -rfbport "$VNC_PORT" \
    -SecurityTypes None \
    -localhost \
    -nolisten tcp \
    -AlwaysShared \
    -AcceptSetDesktopSize=0 &
  wait_until 100 xdpyinfo -display ":${DISPLAY_NUM}" >/dev/null 2>&1 || true
  xdpyinfo -display ":${DISPLAY_NUM}" >/dev/null

  matchbox-window-manager -use_titlebar no >/dev/null 2>&1 &
  websockify --web "$NOVNC_ROOT" "$NOVNC_PORT" "127.0.0.1:${VNC_PORT}" &
  # The sandbox host's proxy rebuilds the Host header from its own upstream address, and Chrome
  # refuses a DevTools request whose Host is not an IP address or localhost, so gost sniffs each
  # HTTP request, the WebSocket upgrade included, and sets its Host to Chrome's.
  local relay_config
  printf -v relay_config '{"services":[{"name":"cdp-relay","addr":":%s","handler":{"type":"tcp","metadata":{"sniffing":true}},"listener":{"type":"tcp"},"forwarder":{"nodes":[{"name":"chrome","addr":"127.0.0.1:%s","http":{"host":"127.0.0.1:%s"}}]}}]}' \
    "$RELAY_PORT" "$CDP_PORT" "$CDP_PORT"
  gost -C "$relay_config" &

  eval "$(python3 /usr/local/bin/guilds-locale --write-profile "$PROFILE")"
  export TZ LANG LANGUAGE CHROME_LANG CHROME_ACCEPT_LANG
  echo "chrome locale tz=${TZ:-UTC} lang=${CHROME_LANG:-en-US} accept=${CHROME_ACCEPT_LANG:-en-US,en}"
  if [ -n "${LANG:-}" ]; then
    localedef -c -i "${LANG%%.*}" -f UTF-8 "$LANG" >/dev/null 2>&1 || true
  fi

  local chrome
  chrome="$(resolve_chrome)"
  while true; do
    clear_stale_chromium_locks
    clear_restored_tabs
    if ! "$chrome" \
      --no-sandbox \
      --disable-dev-shm-usage \
      --use-gl=angle \
      --disable-gpu-compositing \
      --use-angle=swiftshader \
      --enable-unsafe-swiftshader \
      --no-first-run \
      --no-default-browser-check \
      --disable-field-trial-config \
      --password-store=basic \
      --disable-session-crashed-bubble \
      --hide-crash-restore-bubble \
      --disable-blink-features=AutomationControlled \
      --start-maximized \
      --window-size=1280,720 \
      --remote-debugging-port="$CDP_PORT" \
      --remote-debugging-address=127.0.0.1 \
      --user-data-dir="$PROFILE" \
      --homepage=about:blank \
      --lang="${CHROME_LANG:-en-US}" \
      --accept-lang="${CHROME_ACCEPT_LANG:-en-US,en}" \
      about:blank
    then
      echo "chromium exited $?"
    fi
    sleep 1
  done
}

if [ "${GUILDS_BROWSER_SUPERVISE:-}" = "1" ]; then
  supervise
  exit 0
fi

mkdir -p "$PROFILE" "$RUN_DIR" /tmp/.X11-unix
chmod 700 "$RUN_DIR"
chmod 1777 /tmp/.X11-unix
exec 9>"${RUN_DIR}/browser.lock"
flock -w 60 9

if ready; then
  echo "novnc=${NOVNC_PORT} cdp=${CDP_PORT}"
  exit 0
fi

# A supervisor from an earlier start that no longer answers goes before a new one starts.
stop_group_file "$PID_FILE"

GUILDS_BROWSER_SUPERVISE=1 setsid nohup "$0" "$@" >>"$LOG" 2>&1 </dev/null 9>&- &
echo $! > "$PID_FILE"

if wait_until "$READY_TENTHS" ready; then
  echo "novnc=${NOVNC_PORT} cdp=${CDP_PORT}"
  exit 0
fi

echo "browser failed to start" >&2
tail -n 20 "$LOG" >&2 || true
exit 1
