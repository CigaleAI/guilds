#!/usr/bin/env python3
"""A harness CLI for tests: replays a recorded event stream.

Installed under each harness's binary name on PATH. It writes its argv, working directory,
stdin, the content of the file `--system-prompt-file` names, the content and mode of the file
`--mcp-config` names, the variables named in HARNESS_STUB_SHOW, and the names of the variables
whose value holds HARNESS_STUB_SEEK to HARNESS_STUB_RECORD, then prints the
events of HARNESS_STUB_EVENTS one line at a time, HARNESS_STUB_DELAY seconds apart. A line
`{"stub": "edit", "path": ..., "text": ...}` writes that file instead of printing;
`{"stub": "hang"}` sleeps until the process is stopped, and `{"stub": "hang", "ignore_term": true}`
until it is killed. `{"stub": "mcp", "method": ..., "params": ...}` posts that JSON-RPC request to
the `guilds` server of the `--mcp-config` file, with its headers, appends the status and the
answer to HARNESS_STUB_MCP_RECORD, and for a `tools/call` prints the `tool_use` and `tool_result`
events Claude Code prints for an MCP call; `{"stub": "show_mcp_config"}` prints that file's content
as a message. It exits with HARNESS_STUB_EXIT.
"""
import json
import os
import signal
import sys
import time
import urllib.error
import urllib.request


def mcp_request(event, number):
    """Posts the event's JSON-RPC request to the configured server; its status and answer."""
    with open(sys.argv[sys.argv.index("--mcp-config") + 1], encoding="utf-8") as handle:
        server = json.load(handle)["mcpServers"]["guilds"]
    body = json.dumps({"jsonrpc": "2.0", "id": number, "method": event["method"], "params": event.get("params", {})})
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream", **server["headers"]}
    request = urllib.request.Request(server["url"], data=body.encode("utf-8"), headers=headers, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return response.status, json.loads(response.read() or b"null")
    except urllib.error.HTTPError as error:
        return error.code, None

if len(sys.argv) > 1 and sys.argv[1] == "--version":
    print(os.environ.get("HARNESS_STUB_VERSION", "9.9.9 (stub)"))
    sys.exit(0)
stdin = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
record = os.environ.get("HARNESS_STUB_RECORD")
if record:
    shown = {name: os.environ.get(name) for name in os.environ.get("HARNESS_STUB_SHOW", "").split(",") if name}
    system = None
    if "--system-prompt-file" in sys.argv:
        with open(sys.argv[sys.argv.index("--system-prompt-file") + 1], encoding="utf-8") as handle:
            system = handle.read()
    mcp_config = None
    mcp_config_mode = None
    if "--mcp-config" in sys.argv:
        mcp_path = sys.argv[sys.argv.index("--mcp-config") + 1]
        with open(mcp_path, encoding="utf-8") as handle:
            mcp_config = json.load(handle)
        mcp_config_mode = os.stat(mcp_path).st_mode & 0o777
    seek = os.environ.get("HARNESS_STUB_SEEK", "")
    holding = [name for name, value in os.environ.items() if seek and name != "HARNESS_STUB_SEEK" and seek in value]
    with open(record, "a", encoding="utf-8") as handle:
        entry = {
            "argv": sys.argv,
            "cwd": os.getcwd(),
            "stdin": stdin,
            "system_prompt": system,
            "mcp_config": mcp_config,
            "mcp_config_mode": mcp_config_mode,
            "env": shown,
            "env_holding_seek": holding,
        }
        handle.write(json.dumps(entry) + "\n")
delay = float(os.environ.get("HARNESS_STUB_DELAY", "0"))
with open(os.environ["HARNESS_STUB_EVENTS"], encoding="utf-8") as events:
    for line in events:
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except ValueError:
            event = {}
        if not isinstance(event, dict):
            event = {}
        if event.get("stub") == "edit":
            with open(event["path"], "w", encoding="utf-8") as target:
                target.write(event["text"])
            continue
        if event.get("stub") == "show_mcp_config":
            with open(sys.argv[sys.argv.index("--mcp-config") + 1], encoding="utf-8") as handle:
                shown = handle.read()
            print(json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": shown}]}, "session_id": "stub"}), flush=True)
            continue
        if event.get("stub") == "mcp":
            number = event.get("id", 1)
            if event["method"] == "tools/call":
                use = {"type": "tool_use", "id": f"toolu_mcp_{number}", "name": f"mcp__guilds__{event['params']['name']}", "input": event["params"].get("arguments", {})}
                print(json.dumps({"type": "assistant", "message": {"content": [use]}, "session_id": "stub"}), flush=True)
            status, answer = mcp_request(event, number)
            with open(os.environ["HARNESS_STUB_MCP_RECORD"], "a", encoding="utf-8") as handle:
                handle.write(json.dumps({"method": event["method"], "status": status, "answer": answer}) + "\n")
            if event["method"] == "tools/call":
                text = "".join(part.get("text", "") for part in ((answer or {}).get("result") or {}).get("content", []))
                result = {"type": "tool_result", "tool_use_id": f"toolu_mcp_{number}", "content": text}
                print(json.dumps({"type": "user", "message": {"content": [result]}, "session_id": "stub"}), flush=True)
            continue
        if event.get("stub") == "hang":
            if event.get("ignore_term"):
                signal.signal(signal.SIGTERM, signal.SIG_IGN)
            while True:
                time.sleep(1)
        sys.stdout.write(line if line.endswith("\n") else line + "\n")
        sys.stdout.flush()
        time.sleep(delay)
sys.exit(int(os.environ.get("HARNESS_STUB_EXIT", "0")))
