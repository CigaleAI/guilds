        "type": "object",
        "properties": {
          "woeid": {
            "type": "string",
            "description": "Yahoo WOEID. Default 1 (worldwide)."
          },
          "limit": {
            "type": "integer",
            "description": "Rows this page. Default 15, max 30."
          }
        }
      }
    }
  ]
